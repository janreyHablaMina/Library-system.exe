{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "infoLib",
    "version":  "0.1.0",
    "identifier":  "ph.edu.gendejesus.infolib",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://127.0.0.1:5173",
                  "beforeDevCommand":  "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-dev.ps1",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "infoLib",
                                    "width":  820,
                                    "height":  560,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "minWidth":  820,
                                    "minHeight":  560
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}
